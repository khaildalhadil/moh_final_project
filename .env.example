# Copy this file to .env.local and fill in the values from:
# Supabase Dashboard → Project Settings → API (or "Connect" → App Frameworks → Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: public URL of the deployed site (used in email confirmation / reset links).
# Leave empty in development — the request origin is used instead.
NEXT_PUBLIC_SITE_URL=
